<h1>Search for flights</h1>

<%= form_with url: flights_path, method: :get do |_form| %>
  <p>
    <%= label_tag "departure_airport_id" %>
    <%=
      select_tag(
        :departure_airport_id,
        options_from_collection_for_select(@airports.order(:code), :id, :code),
        prompt: "Select a departure airport",
        required: true
      )
    %>
  </p>

  <p>
    <%= label_tag "arrival_airport_id" %>
    <%=
      select_tag(
        :arrival_airport_id,
        options_from_collection_for_select(@airports.order(:code), :id, :code),
        prompt: "Select an arrival airport",
        required: true
      )
    %>
  </p>

  <p>
    <%= label_tag "departure_date" %>
    <%=
      select_tag(
        :departure_date,
        options_from_collection_for_select(
          @flights.order(:departure_date).pluck(:departure_date).uniq,
          :itself,
          :itself
        ),
        prompt: "Select a departure date",
        required: true
      )
    %>
  </p>

  <p>
    <%= 
      label_tag(
        "number_of_passengers",
        "Number of passengers (between 1 and 4 inclusive)" 
      )
    %>
    <%= number_field_tag :number_of_passengers, 1, in: 1..4, step: 1, required: true %>
  </p>
  
  <p>
    <%= submit_tag "Search" %>
  </p>
<% end %>

<h2>Search results</h2>

<p>
  <%= params %>
</p>

<% if @searched_flights.none? %>
  <p>No flights match the search criteria.</p>
<% elsif @searched_flights.any? %>
  <p>The following flight(s) match your search criteria.</p>
  <p>
    <%= debug @searched_flights %>
  </p>
<% end %>
