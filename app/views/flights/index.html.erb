<h1>Search for flights</h1>

<%= form_with url: flights_path, method: :get do |_form| %>
  <p>
    <%= label_tag "departure_airport_id" %>
    <%=
      select_tag(
        :departure_airport_id,
        options_from_collection_for_select(@airports.order(:code), :id, :code),
        prompt: "Select a departure airport"
      )
    %>
  </p>

  <p>
    <%= label_tag "arrival_airport_id" %>
    <%=
      select_tag(
        :arrival_airport_id,
        options_from_collection_for_select(@airports.order(:code), :id, :code),
        prompt: "Select an arrival airport"
      )
    %>
  </p>

  <p>
    <%= label_tag "departure_date" %>
    <%=
      select_tag(
        :departure_date,
        options_from_collection_for_select(Flight.unique_flight_departure_dates, :itself, :itself),
        prompt: "Select a departure date"
      )
    %>
  </p>

  <p>
    <%= 
      label_tag(
        "number_of_passengers",
        "Number of passengers (between 1 and 4 inclusive)" 
      )
    %>
    <%= number_field_tag :number_of_passengers, 1, in: 1..4, step: 1 %>
  </p>
  
  <p>
    <%= submit_tag "Search" %>
  </p>
<% end %>
